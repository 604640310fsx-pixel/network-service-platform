[Unit]
Description=Monitor gateway private mTLS projection
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300s
StartLimitBurst=3

[Service]
Type=simple
User=monitor-gateway
Group=monitor-gateway
WorkingDirectory=/opt/network-service-platform/monitor-gateway/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/monitor-gateway/private.env
ExecStartPre=/usr/bin/test -L /opt/network-service-platform/monitor-gateway/current
ExecStart=/usr/bin/python3 -m monitoring.gateway.server private
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStartSec=75s
TimeoutStopSec=65s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitor-gateway-private

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077

[Install]
WantedBy=multi-user.target
