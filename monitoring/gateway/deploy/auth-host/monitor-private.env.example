# Auth host settings for the private monitor projection.
# Install as /etc/network-service-platform/monitor-private.env (root, 0600) and
# list it as the LAST EnvironmentFile= of the normal Auth window drop-in, so it
# overrides an earlier MONITOR_AUTH_PROJECTION_ENABLED=false. See ../../DEPLOY.md.
# Intentionally empty origin: Auth refuses to start with the flag on and no
# approved private HTTPS origin (https://<private-link-ip>:<port>).
MONITOR_AUTH_PROJECTION_ENABLED=true
MONITOR_AUTH_PRIVATE_ORIGIN=
