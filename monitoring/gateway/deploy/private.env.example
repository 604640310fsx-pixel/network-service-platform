# Private gateway environment for the account /status path
# (website /status -> Auth BFF -> this private listener -> raw monitor).
# Install as /etc/monitor-gateway/private.env (root:monitor-gateway, 0640).
# Contains file paths and non-secret settings only; certificate and key bodies
# live in /etc/monitor-gateway/pki and are never copied into this file.

# Approved private-link (overlay) address and port that the Auth host reaches.
# Intentionally empty: the gateway refuses to start until the approved
# binding is filled in. Must be a private address; wildcard/public is rejected.
PRIVATE_MONITOR_BIND_HOST=
PRIVATE_MONITOR_PORT=

# Private listener TLS server identity and the CA that signs client identities.
PRIVATE_MONITOR_TLS_CERT_FILE=/etc/monitor-gateway/pki/private-server.crt
PRIVATE_MONITOR_TLS_KEY_FILE=/etc/monitor-gateway/pki/private-server.key
PRIVATE_MONITOR_CLIENT_CA_FILE=/etc/monitor-gateway/pki/private-ca.pem

# Client identity certificates (fingerprint-bound, independently revocable).
# PUBLIC_BFF is required by the gateway at startup. AUTH_SERVICE is optional
# for the gateway itself but REQUIRED for /status: the private ACL allows
# /api/auth-service/targets and /api/auth-service/status only for this identity.
PUBLIC_BFF_IDENTITY_CERT_FILE=/etc/monitor-gateway/pki/public-bff-client.crt
AUTH_SERVICE_IDENTITY_CERT_FILE=/etc/monitor-gateway/pki/auth-service-client.crt

# Target key of the single operator server shown on the public /status page.
# Server-side only: never taken from a request and never returned (the public
# response carries only the catalog display label). Empty keeps the public
# server-status route unconfigured (404).
PUBLIC_SERVER_STATUS_TARGET=

# Raw monitor source: the loopback-only dashboard-next candidate that provides
# customer_state (plain HTTP on loopback; RAW_MONITOR_CA_FILE only for HTTPS).
RAW_MONITOR_API_ORIGIN=http://127.0.0.1:3013
