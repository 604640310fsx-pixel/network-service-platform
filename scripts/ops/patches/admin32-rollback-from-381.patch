 }
@@ -430,1 +432,28 @@
 }
+
+export function openRollbackDatabase32(dbPath: string): DatabaseConnection {
+  if (!dbPath.trim()) throw new Error("DB_PATH is required");
+  verifyMigrationFiles(resolveDefaultMigrationsDirectory());
+  // fileMustExist prevents this recovery path from creating a replacement DB.
+  // Check the complete ledger before any pragma or migration write.
+  const database = new Database(dbPath, { fileMustExist: true });
+  try {
+    const versions = readAppliedMigrationVersions(database);
+    if (versions.length !== MIGRATION_FILES.length ||
+        versions.some((version, index) => version !== index + 1)) {
+      throw new Error("Rollback Auth requires exact existing 001-032 ledger");
+    }
+    database.pragma("foreign_keys = ON");
+    database.pragma("journal_mode = WAL");
+    database.pragma(`busy_timeout = ${SQLITE_BUSY_TIMEOUT_MS}`);
+    database.pragma("synchronous = NORMAL");
+    verifyPragmaState(readPragmaState(database));
+    if (!prepareDatabaseReadinessProbe(database).isReady()) {
+      throw new Error("Rollback Auth requires ready 001-032 ledger");
+    }
+    return database;
+  } catch (error) {
+    database.close();
+    throw error;
+  }
+}
